# Copy this file to .env. Neither value is a secret: every VITE_ variable is readable in the
# browser bundle, so never put a password, key or token in one.

# true  = mock data (in-memory demo database, development-only demo accounts)
# false = real API
# Not set: mock data under `npm run dev`, real API in a production build.
# A demo build that should run on mock data needs VITE_USE_MOCK_DATA=true at build time.
VITE_USE_MOCK_DATA=true

# Base URL of the backend API (used when VITE_USE_MOCK_DATA is false).
VITE_API_BASE_URL=http://localhost:5000/api
